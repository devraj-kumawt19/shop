{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci && npm --prefix server ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
  "api/index.js": {
    "maxDuration": 60,
    "includeFiles": "dist/index.html,server/assets/fonts/**"
  }
},
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/products/:id",
      "destination": "/api/index"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/internal/notifications",
      "schedule": "0 6 * * *"
    }
  ]
}
