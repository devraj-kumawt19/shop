PORT=5000
MONGO_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/shopsphere?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=ShopSphere Admin
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_NAME=Website Owner
SUPER_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

# Razorpay: start with test keys. Enable automatic capture in your gateway dashboard.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Resend: use a verified sender address/domain.
RESEND_API_KEY=
RESEND_FROM=
ORDER_NOTIFICATION_EMAIL=
